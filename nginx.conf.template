worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format main '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    'upstream=$upstream_addr upstream_status=$upstream_status '
                    'upstream_time=$upstream_response_time request_time=$request_time '
                    '"$http_user_agent"';
    access_log /dev/stdout main;
    sendfile on;
    keepalive_timeout 65;

    server {
        listen ${NGINX_PORT};
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        # Re-resolve K8s Service ClusterIPs on each request (avoids stale IP after helm service recreate).
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        resolver_timeout 5s;

        location /api/catalogue/ {
            set $catalogue_upstream ${CATALOGUE_HOST}:${CATALOGUE_PORT};
            rewrite ^/api/catalogue/(.*)$ /$1 break;
            proxy_pass http://$catalogue_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /api/user/ {
            set $user_upstream ${USER_HOST}:${USER_PORT};
            rewrite ^/api/user/(.*)$ /$1 break;
            proxy_pass http://$user_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /api/cart/ {
            set $cart_upstream ${CART_HOST}:${CART_PORT};
            rewrite ^/api/cart/(.*)$ /cart/$1 break;
            proxy_pass http://$cart_upstream;
            proxy_connect_timeout 10s;
            proxy_send_timeout 90s;
            proxy_read_timeout 90s;
            proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
            proxy_next_upstream_tries 3;
            proxy_next_upstream_timeout 30s;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /api/shipping/ {
            set $shipping_upstream ${SHIPPING_HOST}:${SHIPPING_PORT};
            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://$shipping_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /api/payment/ {
            set $payment_upstream ${PAYMENT_HOST}:${PAYMENT_PORT};
            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://$payment_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /api/ratings {
            set $ratings_upstream ${RATINGS_HOST}:${RATINGS_PORT};
            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://$ratings_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /api/orders/ {
            set $orders_upstream ${ORDERS_HOST}:${ORDERS_PORT};
            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://$orders_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location / {
            try_files $uri $uri/index.html $uri.html /index.html;
        }

        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
            expires 7d;
            add_header Cache-Control "public";
        }

        # Orders service POSTs here after checkout; no notification microservice in this stack yet.
        location = /notification/send {
            access_log off;
            default_type application/json;
            return 200 '{"status":"OK"}';
        }

        location /send {
            access_log off;
            return 200 "OK\n";
        }

        location /nginx-health {
            access_log off;
            return 200 "OK\n";
        }
    }
}
